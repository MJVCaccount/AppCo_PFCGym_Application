# Copy to .env.local and set a long random value before deploying.
# Used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Pooled Neon PostgreSQL connection string (host contains "-pooler").
# Used by the app at runtime through Prisma Client.
DATABASE_URL=

# Direct, non-pooled Neon connection string. Used only by prisma migrate,
# which needs a real session rather than a PgBouncer pooled connection.
DIRECT_URL=

# Database for `npm test` only: a separate Neon branch named `test` (use its
# direct, non-pooled string) or a local Postgres. The tests EMPTY EVERY TABLE
# and re-seed, and refuse to run if this is unset or names the same database
# as DATABASE_URL or DIRECT_URL.
TEST_DATABASE_URL=

# Public base URL of the app, no trailing slash (e.g. http://localhost:3000).
# Used to build every absolute link in emails (never taken from request
# headers). In production it must start with https:// or the server will
# refuse to start.
APP_URL=

# Resend API key (resend.com). Without it no email is sent: development logs a
# skipped email, production logs an error, and the app keeps working.
RESEND_API_KEY=

# The From address for every email, e.g. PFC <no-reply@your-verified-domain>.
# Its domain must be verified in Resend.
EMAIL_FROM=

# Where contact-form enquiries are delivered. Replies go to the visitor.
CONTACT_INBOX=

# Id of the PUBLIC Vercel Blob store (coach and event images). Find it on the
# store's page in the Vercel dashboard (Storage tab). On Vercel the store is
# connected with OIDC, so this id is all the app needs.
PUBLIC_BLOB_STORE_ID=

# Id of the PRIVATE Vercel Blob store (fighters' medical and licence
# documents). Never the same store as the public one.
PRIVATE_BLOB_STORE_ID=

# Optional, for local use only: read-write tokens for the two stores above.
# Leave blank to authenticate with the short-lived VERCEL_OIDC_TOKEN that
# `vercel env pull .env.local` writes.
PUBLIC_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Optional. Set to 1 to send the Content-Security-Policy as report-only: the
# browser logs violations but blocks nothing. Leave unset in normal use (the
# policy is enforced); use it to debug a page the policy blocks.
CSP_REPORT_ONLY=

# Hosts the seed (npm run db:seed, and db:reset which seeds afterwards) may
# write to, comma separated, besides localhost. Put the Neon DEV host here
# (the host of DIRECT_URL, without "-pooler"). The seed creates demo accounts
# with known passwords, so it refuses any other database.
SEED_ALLOWED_HOSTS=

# Set for ONE command, never saved in a file: the host of a database the seed
# should run against once on purpose, e.g. production on its first deploy.
# See docs/OPERATIONS.md.
SEED_CONFIRM_HOST=

# Optional. Whole number from 1 to 20 (default 1; anything else is ignored).
# Multiplies every rate limit, so on a busy day (a crowd on one venue network
# shares one address, and would hit 5 sign-ups an hour and 30 sign-in attempts
# per 15 minutes) the limits can be relaxed from the Vercel dashboard without a
# deploy. Set it back to 1 afterwards.
RATE_LIMIT_MULTIPLIER=

# Optional, for `npm run smoke` only: Vercel's "Protection Bypass for
# Automation" secret, sent as x-vercel-protection-bypass when Deployment
# Protection is on.
SMOKE_BYPASS_SECRET=

# Passwords for the seeded demo accounts. The published ones (Member123!, Fighter123!,
# Coach123!, Admin123!) are in the public README, so they work on localhost and
# on a host in SEED_ALLOWED_HOSTS only. For any other database (production,
# seeded with SEED_CONFIRM_HOST) BOTH are required, each at least 12 characters,
# different from each other and from the published ones, or the seed refuses.
# Set them for ONE command, never saved in a file.
# SEED_ADMIN_PASSWORD sets the password of admin@pfc.co.za.
SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD sets the password of member@, fighter@, marcus@ and sofia@pfc.co.za.
SEED_DEMO_PASSWORD=
