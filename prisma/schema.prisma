// Prisma schema — Phase 1 foundation.
// Datasource and generator only. Models are added in Phase 2, translated from
// the domain/design class diagrams and ERD in the Task 1 document (User,
// Member, Fighter, Coach, GymClass, Booking, MembershipPlan,
// CompetitionEvent, EventParticipation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
