%% Source: src/actions/auth.ts (requestPasswordReset, submitPasswordReset),
%% src/lib/services/passwordService.ts, src/lib/repositories/passwordResetRepository.ts,
%% src/app/reset-password/[token]/page.tsx, next.config.mjs (headers for /reset-password/:token*).
%% Tests: tests/password.test.ts, tests/security.test.ts (forgot / reset limits), tests/flows.test.ts.
sequenceDiagram
    autonumber
    actor U as Visitor
    participant F as auth actions
    participant RL as rateLimit
    participant P as passwordService
    participant R as passwordResetRepository
    participant DB as PostgreSQL
    participant E as Email (Resend, queued)

    U->>F: requestPasswordReset(email)
    F->>F: validate email format (field error only for a malformed address)
    F->>RL: forgotIp (3 per hour per address) and forgotEmail (3 per hour per email), both fail closed
    RL-->>F: allowed, or Too many attempts
    F->>P: requestReset(email)
    P->>DB: find user by email
    alt known and active
        P->>P: token = 32 random bytes (base64url), tokenHash = sha256(token)
        P->>R: replaceToken(userId, tokenHash, now + 60 min)
        R->>DB: BEGIN, delete the user's unused tokens, insert the new token row, COMMIT
        P->>E: notifyPasswordReset (link built from APP_URL)
    else unknown or deactivated
        P->>P: newToken() so the work is comparable, result discarded
    end
    P-->>F: the same message in every case
    F-->>U: If that email is registered, a reset link is on its way.

    U->>U: opens /reset-password/token (Referrer-Policy: no-referrer, Cache-Control: private, no-store)
    U->>F: submitPasswordReset(token, new password)
    F->>RL: resetIp (10 per hour per address, fail closed)
    F->>P: resetPassword(token, password)
    P->>P: password rule (8+ characters), token length 1 to 200
    P->>P: scrypt hash with a fresh salt
    P->>R: consumeToken(sha256(token), hash, salt, now)
    R->>DB: BEGIN
    R->>DB: UPDATE token SET usedAt = now WHERE hash matches, usedAt IS NULL, expiresAt > now, user active
    alt 0 rows (unknown, used, expired, or lost a race)
        R-->>P: ok false
        P-->>F: 400 This reset link is invalid or has expired.
        F-->>U: same message
    else 1 row
        R->>DB: UPDATE User SET passwordHash, passwordSalt, sessionVersion = sessionVersion + 1
        R->>DB: DELETE the user's other tokens
        R->>DB: INSERT AuditLog password.reset
        R->>DB: COMMIT
        P-->>F: ok
        F-->>U: redirect /login?notice=Password+updated (every older session is now rejected by getSession)
    end
