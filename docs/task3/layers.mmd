flowchart TD
%% Layering as it is in the code, and as tests/architecture.test.ts enforces it:
%%   * only src/lib/services, src/lib/repositories, src/lib/session.ts and src/lib/rateLimit.ts
%%     may import a repository (session.ts and rateLimit.ts use one narrow repository each, said in a comment)
%%   * only src/lib/repositories may import src/lib/prisma.ts
%% Pages, components, actions and routes reach data through a service. There are no "direct" edges.
%% Tests may import repositories and prisma directly; that is not shipped code.
    subgraph UI["Pages, components, middleware (src/app, src/components, src/middleware.ts)"]
        PG["page.tsx / layout.tsx<br/>e.g. src/app/dashboard/page.tsx,<br/>Header, Footer, StickyCta"]
        MW["src/middleware.ts<br/>cookie signature + expiry + role gate, CSP nonce"]
    end

    subgraph ENTRY["Entry points that change state"]
        ACT["Server actions (src/actions)<br/>auth.ts, gym.ts, fighter.ts,<br/>coach.ts, admin.ts"]
        RH["Route handlers (src/app/api/**/route.ts)<br/>one apiHandler wrapper: request id, origin check,<br/>session, rate limit, error envelope, access log"]
        OPS["Operator routes<br/>GET /api/health/detail (HEALTH_TOKEN)<br/>GET /api/cron/maintenance (CRON_SECRET)"]
    end

    subgraph SVC["Services (src/lib/services) - all return ServiceResult"]
        S1["bookingService, membershipService,<br/>coachService, eventService,<br/>fighterService, documentService,<br/>imageService, contactService"]
        S2["classAdminService, coachAdminService,<br/>memberAdminService, planAdminService,<br/>auditService, passwordService, inviteService,<br/>erasureService"]
        S4["authService, catalogueService,<br/>timetableService, dashboardService,<br/>healthService, maintenanceService"]
        S3["notificationService -> outboxService<br/>(stored first, sent second, retried, capped)"]
    end

    subgraph REPO["Repositories (src/lib/repositories) - the only importers of src/lib/prisma.ts"]
        R1["bookingsRepository, timetableRepository,<br/>classAdminRepository, programmesRepository,<br/>coachesRepository, attendanceRepository"]
        R2["usersRepository, plansRepository,<br/>fightersRepository, eventsRepository,<br/>participationsRepository, documentsRepository"]
        R3["passwordResetRepository, rateLimitRepository,<br/>auditRepository, contactRepository,<br/>reviewsRepository, hoursRepository,<br/>healthRepository, outboxRepository"]
    end

    PRISMA["src/lib/prisma.ts<br/>PrismaClient singleton + slow-query warning"]
    DB[("PostgreSQL<br/>prisma/schema.prisma")]

    subgraph SUPPORT["Cross-cutting helpers (no database access of their own)"]
        SES["session.ts / sessionToken.ts<br/>(session.ts reads the account via usersRepository)"]
        RL["rateLimit.ts<br/>(reads/writes via rateLimitRepository)"]
        UP["uploads.ts + uploadInspection.ts -> @vercel/blob"]
        EM["email/send.ts -> Resend"]
        OR["origin.ts, json.ts, csp.ts, returnUrl.ts,<br/>apiEnvelope.ts, requestContext.ts, bearer.ts"]
    end

    MW -. "decodeSession only, no DB" .-> SES
    PG --> ACT
    PG --> S1
    PG --> S4
    ACT --> S1
    ACT --> S2
    ACT --> S4
    RH --> S1
    RH --> S2
    RH --> S4
    OPS --> S4
    RH --> OR
    OPS --> OR
    ACT --> RL
    RH --> RL
    ACT --> SES
    RH --> SES
    S1 --> R1
    S1 --> R2
    S2 --> R1
    S2 --> R2
    S2 --> R3
    S4 --> R1
    S4 --> R2
    S4 --> R3
    S1 --> S3
    S2 --> S3
    S4 --> S3
    S3 --> R3
    S1 --> UP
    S2 --> UP
    S3 --> EM
    R1 --> PRISMA
    R2 --> PRISMA
    R3 --> PRISMA
    PRISMA --> DB
    SES --> R2
    RL --> R3
